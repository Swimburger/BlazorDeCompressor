<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);BlazorDeCompressor.Zstd/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" PrivateAssets="all" />
    <ProjectReference Include="BlazorDeCompressor.Zstd/BlazorDeCompressor.Zstd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" />
    <BlazorWebAssemblyLazyLoad Include="BlazorDeCompressor.Zstd.wasm" />
    <BlazorWebAssemblyLazyLoad Include="ZstdSharp.wasm" />
    <TrimmerRootAssembly Include="BlazorDeCompressor.Zstd" />
  </ItemGroup>

</Project>
