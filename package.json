{
  "name": "blazor-decompressor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "./build.sh",
    "build:cloudflare": "npm run build && cf build",
    "build:cloudflare:prebuilt": "cf build",
    "deploy": "npm run build:cloudflare && cf deploy --prebuilt"
  },
  "devDependencies": {
    "cf": "^1.0.0-beta.31",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261113.1": true
  }
}
