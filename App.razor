@using System.IO
@using System.IO.Compression
@using System.Reflection
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject LazyAssemblyLoader AssemblyLoader

<nav aria-label="Compression format">
    <ul class="nav nav-pills mb-4 pb-1 border-bottom">
        @foreach (var fmt in new[] { CompressionFormat.GZip, CompressionFormat.Brotli, CompressionFormat.Deflate, CompressionFormat.ZLib, CompressionFormat.ZStd })
        {
            <li class="nav-item">
                @if (fmt == _format)
                {
                    <span class="nav-link active" aria-current="page">@FormatDisplayName(fmt)</span>
                }
                else
                {
                    <a class="nav-link" href="@_formatUrls[fmt]">@FormatDisplayName(fmt)</a>
                }
            </li>
        }
    </ul>
</nav>

<fieldset class="border-0 p-0 mb-4" disabled="@isBatchProcessing">
    <legend class="visually-hidden">Mode</legend>
    <div class="btn-group" role="group">
    <input id="radio-compress" class="btn-check" type="radio" autocomplete="off"
        name="compression-mode"
        checked="@(compressionMode == CompressionMode.Compress)"
        @onchange="@(() => compressionMode = CompressionMode.Compress)">
    <label class="btn btn-outline-primary px-4" for="radio-compress">Compress</label>
    <input id="radio-decompress" class="btn-check" type="radio" autocomplete="off"
        name="compression-mode"
        checked="@(compressionMode == CompressionMode.Decompress)"
        @onchange="@(() => compressionMode = CompressionMode.Decompress)">
    <label class="btn btn-outline-primary px-4" for="radio-decompress">Decompress</label>
    </div>
</fieldset>

@if (compressionMode == CompressionMode.Compress)
{
<fieldset class="border-0 p-0 mb-3" disabled="@isBatchProcessing" aria-describedby="compression-level-help">
    <legend class="form-label text-muted small text-uppercase fw-semibold ls-1">Compression Level</legend>
    <p id="compression-level-help" class="text-muted small mb-2">Optimal balances file size and speed. Smallest Size may take longer; Fastest favors speed over size.</p>
    <div class="btn-group d-flex btn-group-sm compression-level-group" role="group">
        <input id="radio-smallest" class="btn-check" type="radio" autocomplete="off"
            name="compression-level"
            checked="@(compressionLevel == CompressionLevel.SmallestSize)"
            @onchange="@(() => compressionLevel = CompressionLevel.SmallestSize)">
        <label class="btn btn-outline-secondary w-100" for="radio-smallest">Smallest Size</label>
        <input id="radio-optimal" class="btn-check" type="radio" autocomplete="off"
            name="compression-level"
            checked="@(compressionLevel == CompressionLevel.Optimal)"
            @onchange="@(() => compressionLevel = CompressionLevel.Optimal)">
        <label class="btn btn-outline-secondary w-100" for="radio-optimal">Optimal</label>
        <input id="radio-fastest" class="btn-check" type="radio" autocomplete="off"
            name="compression-level"
            checked="@(compressionLevel == CompressionLevel.Fastest)"
            @onchange="@(() => compressionLevel = CompressionLevel.Fastest)">
        <label class="btn btn-outline-secondary w-100" for="radio-fastest">Fastest</label>
        <input id="radio-no-compression" class="btn-check" type="radio" autocomplete="off"
            name="compression-level"
            checked="@(compressionLevel == CompressionLevel.NoCompression)"
            @onchange="@(() => compressionLevel = CompressionLevel.NoCompression)">
        <label class="btn btn-outline-secondary w-100" for="radio-no-compression">No Compression</label>
    </div>
</fieldset>
}

<div class="drop-zone mb-4 @(_dragCount > 0 ? "drop-zone--active" : "")"
     @ondragenter="@(() => _dragCount++)"
     @ondragleave="@(() => _dragCount--)"
     @ondrop="@(() => _dragCount = 0)"
     @ondragover:preventDefault>
    @if (compressionMode == CompressionMode.Compress)
    {
        <p class="mb-1 fw-medium">Choose files to compress to @FormatName</p>
    }
    else
    {
        <p class="mb-1 fw-medium">Choose @FormatName files to decompress</p>
    }
    <p class="text-muted small mb-0">or drag and drop here</p>
    <InputFile OnChange="OnFilesChange" multiple class="drop-zone-input"
        disabled="@isBatchProcessing"
        aria-label="@(compressionMode == CompressionMode.Compress ? $"Choose files to compress to {FormatName}" : $"Choose {FormatName} files to decompress")"
        accept="@(compressionMode == CompressionMode.Decompress ? Extension : "")" />
</div>

<div class="mb-3">
    @if (compressionMode == CompressionMode.Compress)
    {
        <button class="btn btn-primary btn-lg w-100" @onclick="CompressFiles" disabled="@(!AnyReadyFiles || !IsFormatReady || isBatchProcessing)">Compress Files</button>
    }
    else
    {
        <button class="btn btn-primary btn-lg w-100" @onclick="DecompressFiles" disabled="@(!AnyReadyFiles || !IsFormatReady || isBatchProcessing)">Decompress Files</button>
    }
    @if (!IsFormatReady)
    {
        <div class="text-muted small text-center mt-1" role="status">Loading Zstandard module…</div>
    }
    else if (files.Count == 0)
    {
        <div class="text-danger small text-center mt-1" role="status">No files selected</div>
    }
</div>

@if (files.Count > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <p id="batch-summary" class="text-muted small mb-0">@FileSummary</p>
        @if (files.Any(file => file.Status == "Finished"))
        {
            <button type="button" class="btn btn-outline-secondary btn-sm file-action" @onclick="ClearCompleted">Clear completed</button>
        }
    </div>
    <p id="batch-announcement" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@batchAnnouncement</p>
}

<ul class="list-group" aria-label="Selected files">
@foreach (var file in files)
{
    <li class="list-group-item d-flex align-items-center gap-2 py-2">
        <span id="@($"file-name-{file.Id}")" class="text-truncate flex-grow-1 small fw-medium">
            @file.OriginalName
            @if (file.NewName is not null)
            {
                <span class="text-muted"> → @file.NewName</span>
            }
            @if (file.OutputNameAdjusted)
            {
                <small class="d-block text-muted fw-normal">Renamed to avoid overwriting another output.</small>
            }
        </span>
        @if (file.Status == "To Process" && file.OriginalSize > WarnFileSizeBytes)
        {
            <small class="text-warning text-nowrap">⚠ >250 MB</small>
        }
        @if(file.Status == "Queued")
        {
            <small class="text-muted text-nowrap">Queued</small>
        }
        @if(file.Status == "Compressing" || file.Status == "Decompressing")
        {
            <div class="spinner-grow text-primary spinner-grow-sm flex-shrink-0" aria-hidden="true"></div>
            <small class="text-muted text-nowrap">@file.Status…</small>
        }
        @if(file.Status == "Cancelling")
        {
            <small class="text-muted text-nowrap">Cancelling…</small>
        }
        @if(file.Status == "Cancelled")
        {
            <small class="text-muted text-nowrap">Cancelled</small>
        }
        @if(file.Status.StartsWith("Error"))
        {
            <small class="text-danger text-nowrap">⚠ @file.Status</small>
        }
        @if(file.Status == "Finished")
        {
            <span class="text-success flex-shrink-0">✔ Finished</span>
            <span class="text-muted small text-nowrap">@FormatBytes(file.OriginalSize) → @FormatBytes(file.OutputSize)</span>
            @if (compressionMode == CompressionMode.Compress)
            {
                <span class="@RatioBadgeCss(file.OriginalSize, file.OutputSize) ms-1">@RatioText(file.OriginalSize, file.OutputSize)</span>
            }
        }
        @if (IsProcessing(file))
        {
            <button type="button" class="btn btn-outline-danger btn-sm file-action"
                aria-describedby="@($"file-name-{file.Id}")" @onclick="@(() => CancelFile(file))">Cancel</button>
        }
        else
        {
            <button type="button" class="btn btn-outline-secondary btn-sm file-action"
                aria-describedby="@($"file-name-{file.Id}")" @onclick="@(() => RemoveFile(file))">Remove</button>
        }
    </li>
}
</ul>

@code {
    private enum CompressionFormat { GZip, Brotli, Deflate, ZLib, ZStd }

    private CompressionMode compressionMode = CompressionMode.Compress;
    private CompressionLevel compressionLevel = CompressionLevel.Optimal;
    private List<Models.File> files = new List<Models.File>();
    private CompressionFormat _format = CompressionFormat.GZip;
    private int _dragCount;
    private bool isBatchProcessing;
    private string batchAnnouncement = "";
    private readonly Dictionary<CompressionFormat, string> _formatUrls = new();
    private Type? _zstdStreamFactory;
    private bool IsFormatReady => _format != CompressionFormat.ZStd || _zstdStreamFactory is not null;
    private const long WarnFileSizeBytes = 250L * 1024 * 1024;
    private static readonly SemaphoreSlim _semaphore = new(4, 4);
    private bool AnyReadyFiles => files.Any(file => file.Status == "To Process");
    private string FileSummary
    {
        get
        {
            var processing = files.Count(IsProcessing);
            var finished = files.Count(file => file.Status == "Finished");
            var cancelled = files.Count(file => file.Status == "Cancelled");
            var failed = files.Count(IsFailed);

            if (isBatchProcessing)
                return $"Batch in progress: {processing} processing, {finished} completed, {cancelled} cancelled, {failed} failed.";

            if (finished + cancelled + failed > 0 && !AnyReadyFiles)
                return BuildBatchCompletionSummary(finished, cancelled, failed);

            var operation = compressionMode == CompressionMode.Compress ? "compress" : "decompress";
            return $"{files.Count} file{(files.Count == 1 ? "" : "s")} selected. Ready to {operation}.";
        }
    }

    private string BuildBatchCompletionSummary(int? finishedCount = null, int? cancelledCount = null, int? failedCount = null)
    {
        var completed = finishedCount ?? files.Count(file => file.Status == "Finished");
        var cancelled = cancelledCount ?? files.Count(file => file.Status == "Cancelled");
        var failed = failedCount ?? files.Count(IsFailed);
        var summary = $"Batch complete: {completed} completed, {cancelled} cancelled, {failed} failed.";
        if (completed == 0) return summary;

        var completedFiles = files.Where(file => file.Status == "Finished").ToList();
        var inputBytes = completedFiles.Sum(file => file.OriginalSize);
        var outputBytes = completedFiles.Sum(file => file.OutputSize);
        return $"{summary} Completed files: {FormatBytes(inputBytes)} input → {FormatBytes(outputBytes)} output, {SizeChangeText(inputBytes, outputBytes)}.";
    }

    private static string SizeChangeText(long inputBytes, long outputBytes)
    {
        if (inputBytes <= 0 || inputBytes == outputBytes) return "no size change";
        var percentage = Math.Abs(1.0 - (double)outputBytes / inputBytes) * 100;
        var amount = percentage < 1 ? "less than 1%" : $"{percentage:F0}%";
        return outputBytes < inputBytes ? $"{amount} saved" : $"expanded by {amount}";
    }

    private static string FormatSlug(CompressionFormat fmt) => fmt switch
    {
        CompressionFormat.Brotli  => "brotli",
        CompressionFormat.Deflate => "deflate",
        CompressionFormat.ZLib    => "zlib",
        CompressionFormat.ZStd    => "zstd",
        _                         => "gzip"
    };

    private static string FormatDisplayName(CompressionFormat fmt) => fmt switch
    {
        CompressionFormat.Brotli  => "Brotli",
        CompressionFormat.Deflate => "Deflate",
        CompressionFormat.ZLib    => "ZLib",
        CompressionFormat.ZStd    => "Zstandard",
        _                         => "GZIP"
    };

    private string FormatName => FormatSlug(_format);
    private string Extension => _format switch
    {
        CompressionFormat.Brotli  => ".br",
        CompressionFormat.Deflate => ".deflate",
        CompressionFormat.ZLib    => ".zlib",
        CompressionFormat.ZStd    => ".zst",
        _                         => ".gz"
    };

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavManager.Uri);
        var host = uri.Host;
        _format = host switch
        {
            _ when host.Contains("brotli")  => CompressionFormat.Brotli,
            _ when host.Contains("deflate") => CompressionFormat.Deflate,
            _ when host.Contains("zlib")    => CompressionFormat.ZLib,
            _ when host.Contains("zstd")    => CompressionFormat.ZStd,
            _                               => CompressionFormat.GZip
        };

        var currentSlug = FormatSlug(_format);
        var port = uri.IsDefaultPort ? "" : $":{uri.Port}";
        foreach (var fmt in new[] { CompressionFormat.GZip, CompressionFormat.Brotli, CompressionFormat.Deflate, CompressionFormat.ZLib, CompressionFormat.ZStd })
        {
            if (host.Contains(currentSlug))
            {
                var newHost = host.Replace(currentSlug, FormatSlug(fmt));
                _formatUrls[fmt] = $"{uri.Scheme}://{newHost}{port}";
            }
            else
            {
                _formatUrls[fmt] = "#";
            }
        }

        if (_format == CompressionFormat.ZStd)
        {
            var assemblies = await AssemblyLoader.LoadAssembliesAsync([
                "BlazorDeCompressor.Zstd.wasm",
                "ZstdSharp.wasm"
            ]);
            _zstdStreamFactory = assemblies
                .Single(assembly => assembly.GetName().Name == "BlazorDeCompressor.Zstd")
                .GetType("BlazorDeCompressor.Zstd.ZstdStreamFactory", throwOnError: true);
        }
    }

    private Stream CreateCompressStream(Stream output, CompressionLevel level)
    {
        if (_format == CompressionFormat.ZStd)
            return InvokeZstdFactory("CreateCompressionStream", output, ToZstdLevel(level));
        return _format switch
        {
            CompressionFormat.Deflate => new DeflateStream(output, level, leaveOpen: true),
            CompressionFormat.ZLib    => new ZLibStream(output, level, leaveOpen: true),
            _                         => new GZipStream(output, level, leaveOpen: true)
        };
    }

    private static int ToBrotliQuality(CompressionLevel level) => level switch
    {
        CompressionLevel.NoCompression => 0,
        CompressionLevel.Fastest       => 1,
        CompressionLevel.SmallestSize  => 11,
        _                              => 6
    };

    private static int ToZstdLevel(CompressionLevel level) => level switch
    {
        CompressionLevel.NoCompression => 1,
        CompressionLevel.Fastest       => 1,
        CompressionLevel.SmallestSize  => 19,
        _                              => 3
    };

    private Stream CreateDecompressStream(Stream input)
    {
        if (_format == CompressionFormat.ZStd)
            return InvokeZstdFactory("CreateDecompressionStream", input);
        return _format switch
        {
            CompressionFormat.Deflate => new DeflateStream(input, CompressionMode.Decompress),
            CompressionFormat.ZLib    => new ZLibStream(input, CompressionMode.Decompress),
            _                         => new GZipStream(input, CompressionMode.Decompress)
        };
    }

    private Stream InvokeZstdFactory(string methodName, params object[] arguments)
    {
        var method = _zstdStreamFactory?.GetMethod(methodName, BindingFlags.Public | BindingFlags.Static)
            ?? throw new InvalidOperationException("The Zstandard compression module is not loaded.");
        return (Stream)(method.Invoke(null, arguments)
            ?? throw new InvalidOperationException($"{methodName} did not return a stream."));
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    private static string RatioText(long original, long output)
    {
        if (original == 0) return "";
        var pct = (1.0 - (double)output / original) * 100;
        return pct >= 0 ? $"{pct:F0}% smaller" : $"{-pct:F0}% larger";
    }

    private static string RatioBadgeCss(long original, long output)
    {
        var pct = original > 0 ? (1.0 - (double)output / original) * 100 : 0;
        return pct >= 0 ? "badge bg-success" : "badge bg-warning text-dark";
    }

    private void OnFilesChange(InputFileChangeEventArgs e)
    {
        foreach (var existingFile in files)
            existingFile.Cancellation.Dispose();
        files.Clear();
        batchAnnouncement = "";
        files.AddRange(e.GetMultipleFiles(int.MaxValue).Select(f => new Models.File
        {
            BrowserFile = f,
            OriginalName = f.Name,
            OriginalSize = f.Size,
            Status = "To Process"
        }));
    }

    private static bool IsProcessing(Models.File file) =>
        file.Status is "Queued" or "Compressing" or "Decompressing" or "Cancelling";

    private static bool IsFailed(Models.File file) =>
        file.Status.StartsWith("Error", StringComparison.Ordinal);

    private void RemoveFile(Models.File file)
    {
        if (IsProcessing(file)) return;
        file.Cancellation.Dispose();
        files.Remove(file);
        batchAnnouncement = "";
    }

    private void CancelFile(Models.File file)
    {
        if (!IsProcessing(file) || file.Status == "Cancelling") return;
        file.Status = "Cancelling";
        file.Cancellation.Cancel();
    }

    private void ClearCompleted()
    {
        foreach (var file in files.Where(file => file.Status == "Finished").ToList())
        {
            file.Cancellation.Dispose();
            files.Remove(file);
        }
        batchAnnouncement = "";
    }

    private string DecompressedFileName(string originalName)
    {
        if (originalName.EndsWith(Extension, StringComparison.OrdinalIgnoreCase))
        {
            var withoutExtension = originalName[..^Extension.Length];
            return string.IsNullOrWhiteSpace(withoutExtension) ? "decompressed-file" : withoutExtension;
        }

        return string.IsNullOrWhiteSpace(originalName) ? "decompressed-file" : $"{originalName}.decompressed";
    }

    private static void AssignUniqueOutputNames(IReadOnlyList<Models.File> selectedFiles, Func<Models.File, string> nameFactory)
    {
        var usedNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var file in selectedFiles)
        {
            var requestedName = nameFactory(file);
            var extension = Path.GetExtension(requestedName);
            var stem = extension.Length == 0 ? requestedName : requestedName[..^extension.Length];
            var uniqueName = requestedName;
            var suffix = 2;
            while (!usedNames.Add(uniqueName))
                uniqueName = $"{stem} ({suffix++}){extension}";

            file.NewName = uniqueName;
            file.OutputNameAdjusted = !string.Equals(uniqueName, requestedName, StringComparison.Ordinal);
        }
    }

    private async Task<IJSObjectReference?> TryGetFileSystemHandle(string identifier, params object?[] args)
    {
        try
        {
            return await JS.InvokeAsync<IJSObjectReference?>(identifier, args);
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task CompressFiles()
    {
        var selectedFiles = files.Where(file => file.Status == "To Process").ToList();
        if (selectedFiles.Count == 0) return;
        batchAnnouncement = "";
        AssignUniqueOutputNames(selectedFiles, file => $"{file.OriginalName}{Extension}");
        IJSObjectReference? singleHandle = null;
        IJSObjectReference? dirHandle = null;
        if (selectedFiles.Count == 1)
            singleHandle = await TryGetFileSystemHandle("getSaveFileHandle", selectedFiles[0].NewName);
        else
            dirHandle = await TryGetFileSystemHandle("getDirectoryHandle");

        foreach (var file in selectedFiles)
            file.Status = "Queued";
        isBatchProcessing = true;
        var tasks = new List<Task>();
        foreach (var file in selectedFiles)
        {
            var task = Task.Run(async () =>
            {
                MemoryStream? outputStream = null;
                try
                {
                    var cancellationToken = file.Cancellation.Token;
                    await _semaphore.WaitAsync(cancellationToken);
                    try
                    {
                        file.Status = "Compressing";
                        await InvokeAsync(StateHasChanged);

                        var browserFile = file.BrowserFile;
                        using var inputStream = browserFile.OpenReadStream(long.MaxValue, cancellationToken);
                        if (_format == CompressionFormat.Brotli)
                        {
                            using var ms = new MemoryStream();
                            await inputStream.CopyToAsync(ms, cancellationToken);
                            var compressed = await JS.InvokeAsync<byte[]>("brotliCompress", cancellationToken, [ms.ToArray(), ToBrotliQuality(compressionLevel)]);
                            outputStream = new MemoryStream(compressed);
                        }
                        else
                        {
                            outputStream = new MemoryStream();
                            using (var compressionStream = CreateCompressStream(outputStream, compressionLevel))
                            {
                                await inputStream.CopyToAsync(compressionStream, cancellationToken);
                            }
                        }
                        file.OutputSize = outputStream.Length;
                    }
                    finally { _semaphore.Release(); }

                    cancellationToken.ThrowIfCancellationRequested();
                    outputStream.Position = 0;
                    using var streamRef = new DotNetStreamReference(outputStream, leaveOpen: true);
                    if (singleHandle is not null)
                        await JS.InvokeVoidAsync("saveToFileHandle", singleHandle, streamRef);
                    else if (dirHandle is not null)
                        await JS.InvokeVoidAsync("saveToDirectory", dirHandle, file.NewName, streamRef);
                    else
                        await JS.InvokeVoidAsync("downloadFileFromStream", file.NewName, streamRef);

                    file.Status = "Finished";
                }
                catch (OperationCanceledException)
                {
                    file.Status = "Cancelled";
                }
                catch(Exception ex){
                    file.Status = $"Error: {ex.Message}";
                }
                finally { outputStream?.Dispose(); }
                await InvokeAsync(StateHasChanged);
            });
            tasks.Add(task);
        }

        try
        {
            await Task.WhenAll(tasks);
        }
        finally
        {
            isBatchProcessing = false;
            if (singleHandle is not null) await singleHandle.DisposeAsync();
            if (dirHandle is not null) await dirHandle.DisposeAsync();
            batchAnnouncement = BuildBatchCompletionSummary();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DecompressFiles()
    {
        var selectedFiles = files.Where(file => file.Status == "To Process").ToList();
        if (selectedFiles.Count == 0) return;
        batchAnnouncement = "";
        AssignUniqueOutputNames(selectedFiles, file => DecompressedFileName(file.OriginalName));
        IJSObjectReference? singleHandle = null;
        IJSObjectReference? dirHandle = null;
        if (selectedFiles.Count == 1)
            singleHandle = await TryGetFileSystemHandle("getSaveFileHandle", selectedFiles[0].NewName);
        else
            dirHandle = await TryGetFileSystemHandle("getDirectoryHandle");

        foreach (var file in selectedFiles)
            file.Status = "Queued";
        isBatchProcessing = true;
        var tasks = new List<Task>();
        foreach (var file in selectedFiles)
        {
            var task = Task.Run(async () =>
            {
                MemoryStream? outputStream = null;
                try
                {
                    var cancellationToken = file.Cancellation.Token;
                    await _semaphore.WaitAsync(cancellationToken);
                    try
                    {
                        file.Status = "Decompressing";
                        await InvokeAsync(StateHasChanged);

                        var browserFile = file.BrowserFile;
                        using var inputStream = browserFile.OpenReadStream(long.MaxValue, cancellationToken);
                        if (_format == CompressionFormat.Brotli)
                        {
                            using var ms = new MemoryStream();
                            await inputStream.CopyToAsync(ms, cancellationToken);
                            var decompressed = await JS.InvokeAsync<byte[]>("brotliDecompress", cancellationToken, [ms.ToArray()]);
                            outputStream = new MemoryStream(decompressed);
                        }
                        else
                        {
                            outputStream = new MemoryStream();
                            using var decompressionStream = CreateDecompressStream(inputStream);
                            await decompressionStream.CopyToAsync(outputStream, cancellationToken);
                        }
                        file.OutputSize = outputStream.Length;
                    }
                    finally { _semaphore.Release(); }

                    cancellationToken.ThrowIfCancellationRequested();
                    outputStream.Position = 0;
                    using var streamRef = new DotNetStreamReference(outputStream, leaveOpen: true);
                    if (singleHandle is not null)
                        await JS.InvokeVoidAsync("saveToFileHandle", singleHandle, streamRef);
                    else if (dirHandle is not null)
                        await JS.InvokeVoidAsync("saveToDirectory", dirHandle, file.NewName, streamRef);
                    else
                        await JS.InvokeVoidAsync("downloadFileFromStream", file.NewName, streamRef);

                    file.Status = "Finished";
                }
                catch (OperationCanceledException)
                {
                    file.Status = "Cancelled";
                }
                catch(Exception ex){
                    file.Status = $"Error: {ex.Message}";
                }
                finally { outputStream?.Dispose(); }
                await InvokeAsync(StateHasChanged);
            });
            tasks.Add(task);
        }

        try
        {
            await Task.WhenAll(tasks);
        }
        finally
        {
            isBatchProcessing = false;
            if (singleHandle is not null) await singleHandle.DisposeAsync();
            if (dirHandle is not null) await dirHandle.DisposeAsync();
            batchAnnouncement = BuildBatchCompletionSummary();
            await InvokeAsync(StateHasChanged);
        }
    }
}
